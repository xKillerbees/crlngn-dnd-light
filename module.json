{
  "id": "crlngn-dnd-light",
  "title": "Carolingian UI — D&D Light (PF2e)",
  "description": "Recolours Carolingian UI in the D&D 5e-style light theme from PF2e Dorako UI, keeping Carolingian's character sheets, scene navigation and combat carousel. Also restores Pathfinder 2e's item rarity colours. Applies under either Foundry colour scheme.",
  "version": "3.0.0",
  "compatibility": {
    "minimum": "13",
    "verified": "14"
  },
  "authors": [
    {
      "name": "xKillerbees",
      "url": "https://github.com/xKillerbees"
    }
  ],
  "url": "https://github.com/xKillerbees/crlngn-dnd-light",
  "manifest": "https://raw.githubusercontent.com/xKillerbees/crlngn-dnd-light/refs/heads/main/module.json",
  "download": "https://github.com/xKillerbees/crlngn-dnd-light/releases/download/v3.0.0/module.zip",
  "readme": "https://github.com/xKillerbees/crlngn-dnd-light#readme",
  "bugs": "https://github.com/xKillerbees/crlngn-dnd-light/issues",
  "license": "https://mit-license.org/",
  "relationships": {
    "systems": [
      {
        "id": "pf2e",
        "type": "system",
        "compatibility": {
          "minimum": "7.0.0"
        }
      }
    ],
    "requires": [
      {
        "id": "crlngn-ui",
        "type": "module",
        "manifest": "https://github.com/crlngn/crlngn-ui/releases/latest/download/module.json",
        "compatibility": {
          "minimum": "4.0.0"
        }
      }
    ]
  },
  "styles": [],
  "esmodules": [
    "scripts/crlngn-dnd-light.js"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "flags": {
    "hotReload": {
      "extensions": [
        ".css",
        ".json"
      ]
    }
  },
  "socket": false
}
