{
  "id": "crlngn-dnd-light",
  "title": "Dorako UI + Carolingian Bridge (PF2e)",
  "description": "Runs PF2e Dorako UI's D&D light theme alongside Carolingian UI's scene navigation and combat carousel. Dorako owns sheets, chat and windows; Carolingian keeps its navigation and tracker; this bridges the two so they stop competing.",
  "version": "2.0.1",
  "compatibility": {
    "minimum": "13",
    "verified": "14"
  },
  "authors": [
    {
      "name": "xKillerbees",
      "url": "https://github.com/xKillerbees"
    }
  ],
  "url": "https://github.com/xKillerbees/crlngn-dnd-light",
  "manifest": "https://raw.githubusercontent.com/xKillerbees/crlngn-dnd-light/refs/heads/main/module.json",
  "download": "https://github.com/xKillerbees/crlngn-dnd-light/releases/download/v2.0.1/module.zip",
  "readme": "https://github.com/xKillerbees/crlngn-dnd-light#readme",
  "bugs": "https://github.com/xKillerbees/crlngn-dnd-light/issues",
  "license": "https://mit-license.org/",
  "relationships": {
    "systems": [
      {
        "id": "pf2e",
        "type": "system",
        "compatibility": {
          "minimum": "7.0.0"
        }
      }
    ],
    "requires": [
      {
        "id": "crlngn-ui",
        "type": "module",
        "manifest": "https://github.com/crlngn/crlngn-ui/releases/latest/download/module.json",
        "compatibility": {
          "minimum": "4.0.0"
        }
      },
      {
        "id": "pf2e-dorako-ui",
        "type": "module",
        "manifest": "https://github.com/Dorako/pf2e-dorako-ui/releases/latest/download/module.json",
        "compatibility": {
          "minimum": "1.11.0"
        }
      }
    ]
  },
  "styles": [],
  "esmodules": [
    "scripts/crlngn-dnd-light.js"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "flags": {
    "hotReload": {
      "extensions": [
        ".css",
        ".json"
      ]
    }
  },
  "socket": false
}
