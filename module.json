{
  "id": "crlngn-dnd-light",
  "title": "Carolingian UI — D&D Light (PF2e)",
  "description": "Re-skins Carolingian UI with the D&D 5e-style light theme from PF2e Dorako UI: parchment backgrounds, gold borders, maroon accents, dark text. Also restores Pathfinder 2e's item rarity and proficiency rank colors, which Carolingian UI flattens out on character sheets.",
  "version": "1.0.0",
  "compatibility": {
    "minimum": "13",
    "verified": "14"
  },
  "authors": [
    {
      "name": "xKillerbees",
      "url": "https://github.com/xKillerbees"
    }
  ],
  "url": "https://github.com/xKillerbees/crlngn-dnd-light",
  "manifest": "https://github.com/xKillerbees/crlngn-dnd-light/releases/latest/download/module.json",
  "download": "https://github.com/xKillerbees/crlngn-dnd-light/releases/download/v1.0.0/module.zip",
  "readme": "https://github.com/xKillerbees/crlngn-dnd-light#readme",
  "bugs": "https://github.com/xKillerbees/crlngn-dnd-light/issues",
  "license": "https://mit-license.org/",
  "relationships": {
    "systems": [
      {
        "id": "pf2e",
        "type": "system",
        "compatibility": {
          "minimum": "7.0.0"
        }
      }
    ],
    "requires": [
      {
        "id": "crlngn-ui",
        "type": "module",
        "manifest": "https://github.com/crlngn/crlngn-ui/releases/latest/download/module.json",
        "compatibility": {
          "minimum": "4.0.0"
        }
      }
    ],
    "conflicts": [
      {
        "id": "pf2e-dorako-ui",
        "type": "module",
        "reason": "Both modules restyle the same Foundry elements. Disable PF2e Dorako UI — this module reproduces its D&D light palette on top of Carolingian UI."
      }
    ]
  },
  "styles": [
    "styles/theme.css",
    "styles/sheets.css",
    "styles/pf2e-rarity.css"
  ],
  "esmodules": [
    "scripts/crlngn-dnd-light.js"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "flags": {
    "hotReload": {
      "extensions": [".css", ".json"]
    }
  },
  "socket": false
}
